# Copy this file to .env for local use. Keep real passwords in .env and in the
# hosting provider's Environment settings; .env is intentionally ignored by Git.
ASPNETCORE_ENVIRONMENT=Development

# Shared MongoDB Atlas cluster. Replace DB_PASSWORD with the URL-encoded password
# of the Atlas database user nguyenhaiphong0711.
MongoDb__ConnectionString=mongodb+srv://nguyenhaiphong0711:DB_PASSWORD@cluster0.mcynqfs.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MongoDb__DatabaseName=LMS_Production

# Required only when ASPNETCORE_ENVIRONMENT=Production and Users is empty.
# Remove these values from the hosting environment after the first Admin is created.
Bootstrap__AdminEmail=replace-with-admin-email
Bootstrap__AdminPassword=replace-with-at-least-12-characters

# Gmail SMTP (Google App Password, not your Google account password)
Email__Host=smtp.gmail.com
# 587 uses STARTTLS; 465 uses implicit TLS. TLS verification stays enabled.
Email__Port=587
Email__TimeoutSeconds=20
Email__Username=your-account@gmail.com
Email__AppPassword=replace-with-google-app-password
Email__SenderEmail=your-account@gmail.com
Email__SenderName=LearnSpace

# Enable only on a disposable Development database when sample business data is wanted.
DemoData__Enabled=false

# VNPAY merchant configuration (use sandbox credentials for testing)
Vnpay__TmnCode=your-vnpay-terminal-code
Vnpay__HashSecret=replace-with-vnpay-hash-secret
Vnpay__PaymentUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
Vnpay__BankCode=MB
Vnpay__ReturnUrl=https://your-public-domain/Vnpay/Return
Vnpay__IpnUrl=https://your-public-domain/Vnpay/Ipn
