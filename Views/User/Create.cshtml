@model LMS.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="page-heading"><div><span class="eyebrow">ACCESS MANAGEMENT</span><h1>Tạo tài khoản</h1><p class="muted">Tạo người dùng và gán vai trò trong hệ thống.</p></div></div>

<form method="post" class="form form-card">
    <div asp-validation-summary="All" class="error"></div>

    <label asp-for="FullName">Họ và tên</label>
    <input asp-for="FullName" />
    <span asp-validation-for="FullName" class="error"></span>

    <label asp-for="Email">Email</label>
    <input asp-for="Email" />
    <span asp-validation-for="Email" class="error"></span>

    <label asp-for="Password">Mật khẩu</label>
    <input asp-for="Password" autocomplete="new-password" />
    <span asp-validation-for="Password" class="error"></span>

    <label asp-for="Role">Vai trò</label>
    <select asp-for="Role">
        <option value="Admin">Quản trị viên</option>
        <option value="Teacher">Giảng viên</option>
        <option value="Student">Học viên</option>
    </select>

    <div class="action-row"><button>Tạo tài khoản</button><a class="btn btn-ghost" asp-action="Index">Hủy</a></div>
</form>
