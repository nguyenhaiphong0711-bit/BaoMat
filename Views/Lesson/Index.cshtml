@model List<LMS.Models.Lesson>
@{
    ViewData["Title"] = "Bài học";
}

<div class="title-row">
    <div><span class="eyebrow">@ViewBag.ClassName</span><h1>Bài học</h1><p class="muted">Tài liệu và nội dung học tập của lớp.</p></div>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Teacher))
    {
        <a class="btn" asp-action="Create" asp-route-classId="@ViewBag.ClassId">+ Tạo bài học</a>
    }
</div>

@{
    var filter = ViewBag.Filter as LMS.ViewModels.CatalogFilterViewModel ?? new();
}
<form method="get" class="filter-bar">
    <input type="hidden" name="classId" value="@ViewBag.ClassId" />
    <input name="Query" value="@filter.Query" placeholder="Tìm tiêu đề hoặc nội dung..." />
    @if (!User.IsInRole(Roles.Student))
    {
        <select name="Status">
            <option value="">Mọi trạng thái</option>
            <option value="true" selected="@(filter.Status == "true")">Đã xuất bản</option>
            <option value="false" selected="@(filter.Status == "false")">Bản nháp</option>
        </select>
    }
    <label>Tạo từ <input type="date" name="CreatedFrom" value="@filter.CreatedFrom?.ToString("yyyy-MM-dd")" /></label>
    <label>Đến <input type="date" name="CreatedTo" value="@filter.CreatedTo?.ToString("yyyy-MM-dd")" /></label>
    <button class="btn btn-secondary" type="submit">Lọc</button>
    <a class="btn btn-ghost" asp-action="Index" asp-route-classId="@ViewBag.ClassId">Xóa lọc</a>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state"><span class="empty-icon">▧</span><h2>Chưa có bài học</h2><p class="muted">Bài học của lớp sẽ hiển thị tại đây.</p></div>
}
else
{
    <div class="lesson-grid">
        @foreach (var x in Model)
        {
            <article class="card lesson-card">
                <div class="title-row"><h3>@x.Title</h3><span class="badge @(x.IsPublished ? "badge-open" : "badge-muted")">@(x.IsPublished ? "Đã xuất bản" : "Bản nháp")</span></div>
                <p>@x.Content</p>
                @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Teacher))
                {
                    <div class="action-row">
                        <a class="btn btn-secondary small" asp-action="Edit" asp-route-id="@x.Id">Chỉnh sửa</a>
                        <form method="post" asp-action="Archive" asp-route-id="@x.Id">
                            <button class="btn btn-danger-outline small" type="submit">Lưu trữ</button>
                        </form>
                    </div>
                }
            </article>
        }
    </div>
}
