@model LMS.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-card">
    <span class="eyebrow">XÁC MINH EMAIL</span>
    <h1>Đặt lại mật khẩu</h1>
    @if (ViewBag.Message is string message)
    {
        <div class="flash flash-success" role="status">@message</div>
    }
    <p class="muted">Nhập mã xác nhận đã được gửi đến email tài khoản, sau đó chọn mật khẩu mới.</p>
    <p class="hint">Nếu tài khoản đang hoạt động, hãy kiểm tra hộp thư email để lấy mã OTP. Mã hết hạn sau 10 phút.</p>
    <form method="post" asp-action="ResetPassword">
        <div asp-validation-summary="All" class="error"></div>
        <label asp-for="Email">Email tài khoản</label>
        <input asp-for="Email" type="email" autocomplete="email" />
        <span asp-validation-for="Email" class="error"></span>

        <label asp-for="Code">Mã OTP 6 chữ số</label>
        <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
        <span asp-validation-for="Code" class="error"></span>

        <label asp-for="NewPassword">Mật khẩu mới</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="NewPassword" class="error"></span>

        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="error"></span>

        <button type="submit">Đổi mật khẩu</button>
    </form>
    <a class="auth-help-link" asp-action="ForgotPassword">Gửi lại mã OTP</a>
    <a class="auth-help-link" asp-action="Login">Quay lại đăng nhập</a>
</div>
