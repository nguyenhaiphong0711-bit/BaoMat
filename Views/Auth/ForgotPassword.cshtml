@model LMS.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-card">
    <span class="eyebrow">KHÔI PHỤC TÀI KHOẢN</span>
    <h1>Quên mật khẩu?</h1>
    <p class="muted">Nhập email đã được quản trị viên dùng để tạo tài khoản. Chúng tôi sẽ gửi mã OTP 6 chữ số nếu tài khoản đang hoạt động.</p>
    <form method="post" asp-action="ForgotPassword">
        <div asp-validation-summary="All" class="error"></div>
        <label asp-for="Email">Email tài khoản</label>
        <input asp-for="Email" type="email" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="error"></span>
        <button type="submit">Gửi mã OTP</button>
    </form>
    <a class="auth-help-link" asp-action="Login">Quay lại đăng nhập</a>
</div>
