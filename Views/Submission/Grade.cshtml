@model LMS.ViewModels.GradeViewModel
@{
    ViewData["Title"] = "Chấm bài";
}

<div class="page-heading">
    <div>
        <span class="eyebrow">@ViewBag.Assignment.Title</span>
        <h1>Đánh giá bài nộp</h1>
        <p class="muted">@(ViewBag.Student?.FullName ?? "Học viên") · @(ViewBag.Student?.Email ?? "")</p>
    </div>
    <a class="btn btn-ghost" asp-action="Index" asp-route-assignmentId="@ViewBag.Assignment.Id">Danh sách bài nộp</a>
</div>

<section class="card submission-preview">
    <span class="eyebrow">NỘI DUNG BÀI LÀM</span>
    @if (!string.IsNullOrWhiteSpace((string)ViewBag.Submission.Content))
    {
        <p class="submission-content">@ViewBag.Submission.Content</p>
    }
    @if (ViewBag.Submission.Attachments is IEnumerable<LMS.Models.StoredFileReference> attachments && attachments.Any())
    {
        <div class="file-list">
            <strong>Tệp học viên đã nộp</strong>
            @foreach (var attachment in attachments)
            {
                <a asp-controller="File" asp-action="Download" asp-route-id="@attachment.Id">↧ @attachment.FileName</a>
            }
        </div>
    }
    <small class="muted">Nộp lúc @ViewBag.Submission.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
</section>

<form method="post" class="form form-card">
    <div asp-validation-summary="All" class="error"></div>
    <label asp-for="Grade">Điểm (0–10)</label>
    <input asp-for="Grade" type="number" min="0" max="10" step="0.1" />
    <span asp-validation-for="Grade" class="error"></span>

    <label asp-for="TeacherComment">Nhận xét</label>
    <textarea asp-for="TeacherComment" rows="5"></textarea>
    <span asp-validation-for="TeacherComment" class="error"></span>

    <button type="submit">Lưu điểm và nhận xét</button>
</form>
