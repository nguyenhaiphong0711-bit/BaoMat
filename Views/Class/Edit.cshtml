@model LMS.ViewModels.UpdateClassViewModel
@{
    ViewData["Title"] = "Chỉnh sửa lớp";
}

@{
    var teachers = ViewData["Teachers"] as List<LMS.Models.User> ?? new();
    var students = ViewData["Students"] as List<LMS.Models.User> ?? new();
    var subjects = ViewData["Subjects"] as List<LMS.Models.Subject> ?? new();
    var departments = ViewBag.Departments as List<LMS.Models.Department> ?? new();
    var terms = ViewBag.Terms as List<LMS.Models.AcademicTerm> ?? new();
}

<div class="page-heading"><div><span class="eyebrow">CLASS MANAGEMENT</span><h1>Chỉnh sửa lớp</h1><p class="muted">Cập nhật môn học, giảng viên và danh sách học viên.</p></div></div>

<form method="post" class="form form-card">
    <div asp-validation-summary="All" class="error"></div>
    <label asp-for="Name">Tên lớp</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="error"></span>

    <label asp-for="Description">Mô tả</label>
    <textarea asp-for="Description"></textarea>

    <label>Khoa</label>
    <select id="DepartmentId">
        <option value="">-- Chọn khoa --</option>
        @foreach (var department in departments)
        {
            <option value="@department.Id">@department.Code · @department.Name</option>
        }
    </select>
    <label asp-for="SubjectId">Môn học</label>
    <select asp-for="SubjectId">
        <option value="">-- Chọn môn --</option>
        @foreach (var subject in subjects)
        {
            <option value="@subject.Id" data-department="@subject.DepartmentId">@subject.Code · @subject.Name</option>
        }
    </select>
    <span asp-validation-for="SubjectId" class="error"></span>

    <label asp-for="AcademicTermId">Học kỳ mở lớp</label>
    <select asp-for="AcademicTermId">
        <option value="">-- Chọn học kỳ --</option>
        @foreach (var term in terms)
        {
            <option value="@term.Id">@term.Name (@term.AcademicYear)@(term.IsActive ? " · Đang áp dụng" : "")</option>
        }
    </select>
    <span asp-validation-for="AcademicTermId" class="error"></span>

    <label asp-for="EnrollmentCapacity">Sĩ số tối đa</label>
    <input asp-for="EnrollmentCapacity" type="number" min="1" max="500" />
    <span asp-validation-for="EnrollmentCapacity" class="error"></span>

    <label asp-for="TeacherId">Giảng viên phụ trách</label>
    <select asp-for="TeacherId">
        <option value="">-- Select --</option>
        @foreach (var teacher in teachers)
        {
            <option value="@teacher.Id" data-subjects="@string.Join(",", teacher.TeachingSubjectIds.Select(id => id.ToString()))">@teacher.FullName (@teacher.Email)</option>
        }
    </select>
    <span asp-validation-for="TeacherId" class="error"></span>

    <label asp-for="StudentIds">Học viên</label>
    <select asp-for="StudentIds" multiple>
        @foreach (var student in students)
        {
            <option value="@student.Id">@student.FullName (@student.Email)</option>
        }
    </select>

    <p class="muted">Giữ Ctrl (Windows) hoặc Command (Mac) để chọn nhiều học viên.</p>
    <div class="action-row"><button type="submit">Lưu thay đổi</button><a class="btn btn-ghost" asp-controller="Class" asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]">Hủy</a></div>
</form>
<script>
    const classSubject = document.getElementById("SubjectId");
    const departmentPicker = document.getElementById("DepartmentId");
    const teacherPicker = document.getElementById("TeacherId");
    function filterSubjectsByDepartment() {
        for (const option of classSubject.options) {
            if (!option.value) continue;
            option.hidden = !!departmentPicker.value && option.dataset.department !== departmentPicker.value;
            if (option.hidden && option.selected) classSubject.value = "";
        }
    }
    departmentPicker.addEventListener("change", filterSubjectsByDepartment);
    classSubject.addEventListener("change", () => {
        const selected = classSubject.selectedOptions[0];
        if (selected && selected.dataset.department) departmentPicker.value = selected.dataset.department;
        filterSubjectsByDepartment();
        filterTeachersBySubject();
    });
    function filterTeachersBySubject() {
        const subjectId = classSubject.value;
        for (const option of teacherPicker.options) {
            if (!option.value) continue;
            option.hidden = !option.dataset.subjects.split(",").includes(subjectId);
            if (option.hidden && option.selected) teacherPicker.value = "";
        }
    }
    classSubject.addEventListener("change", filterTeachersBySubject);
    const selectedSubject = classSubject.selectedOptions[0];
    if (selectedSubject && selectedSubject.dataset.department) departmentPicker.value = selectedSubject.dataset.department;
    filterSubjectsByDepartment();
    filterTeachersBySubject();
</script>
