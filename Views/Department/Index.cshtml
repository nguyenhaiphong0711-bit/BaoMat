@model List<LMS.Models.Department>
@{
    ViewData["Title"] = "Khoa";
    var filter = ViewBag.Filter as LMS.ViewModels.CatalogFilterViewModel ?? new();
    var subjectCounts = ViewBag.SubjectCounts as Dictionary<string, int> ?? new();
}

<div class="title-row">
    <div><span class="eyebrow">ACADEMIC STRUCTURE</span><h1>Khoa</h1><p class="muted">Quản lý khoa và cấu trúc Khoa → Môn học → Lớp học.</p></div>
    <a class="btn" asp-action="Create">+ Thêm khoa</a>
</div>
<form method="get" class="filter-bar">
    <input name="Query" value="@filter.Query" placeholder="Tìm mã khoa, tên khoa..." />
    <label>Tạo từ <input type="date" name="CreatedFrom" value="@filter.CreatedFrom?.ToString("yyyy-MM-dd")" /></label>
    <label>Đến <input type="date" name="CreatedTo" value="@filter.CreatedTo?.ToString("yyyy-MM-dd")" /></label>
    <button class="btn btn-secondary" type="submit">Lọc</button>
    <a class="btn btn-ghost" asp-action="Index">Xóa lọc</a>
</form>
<div class="table-wrap">
    <table>
        <thead><tr><th>Mã khoa</th><th>Tên khoa</th><th>Mô tả</th><th>Môn học</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><span class="badge">@item.Code</span></td><td><strong>@item.Name</strong></td><td>@item.Description</td>
                <td>@subjectCounts.GetValueOrDefault(item.Id.ToString())</td><td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td class="action-row"><a class="btn btn-secondary small" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"><button class="btn btn-ghost small" type="submit" onclick="return confirm('Xóa khoa này? Khoa còn môn học sẽ không thể xóa.')">Xóa</button></form>
                </td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="muted">Không tìm thấy khoa phù hợp.</td></tr> }
        </tbody>
    </table>
</div>
